# Copy to .env.local (never commit .env.local or real keys).
# Supabase Dashboard → Project Settings → API (or Data API / API Keys).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public client key: the "publishable" key (sb_publishable_…). The legacy
# "anon" JWT key also works here. Safe in the browser — Row Level Security
# enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Active market from config/region.ts (default: AE).
# NEXT_PUBLIC_REGION=AE

# Server-only. Service role (or "secret", sb_secret_…) key: bypasses RLS.
# Used only to create admin accounts (lib/supabase/admin.ts).
# NEVER give it a NEXT_PUBLIC_ prefix — that would ship it to every browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Enables the one-time first-admin page at /<lang>/setup.
# Generate with: openssl rand -hex 16. Remove it after the first admin exists.
ADMIN_SETUP_TOKEN=

# --- Online payments (Stripe, migration 044) --------------------------------
# Stripe Dashboard → Developers → API keys. Server-only: NEVER add a
# NEXT_PUBLIC_ prefix. Use the test key (sk_test_…) until you go live. Used
# for webhooks, refunds, cancelling unpaid payments and the Payments page.
STRIPE_SECRET_KEY=

# Server-only. Signing secret (whsec_…) of the webhook endpoint
# https://<this app>/api/stripe/webhook (Stripe Dashboard → Developers →
# Webhooks; events listed in README → Payments). Locally: the secret printed
# by `stripe listen --forward-to localhost:3005/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=

# Server-only. Bearer token for GET /api/stripe/expire-orders, which cancels
# unpaid orders past their payment deadline and releases their stock. Call
# it every 5 minutes from a scheduler. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional. The storefront's public URL; suggested on Payments → Apple Pay
# as the domain to register (e.g. https://shop.example.com).
# STOREFRONT_URL=

# Server-only. Shared with the storefront (same value there): lets it ask
# POST /api/stripe/sync to confirm a payment Stripe already reports as paid,
# without waiting for the webhook. Generate with: openssl rand -hex 32
PAYMENTS_SYNC_SECRET=
